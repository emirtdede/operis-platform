# ==============================================================================
# FREELANCE PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# Master Specification: FREELANCE_PLATFORM_MASTER_SPEC.md §59 & §18.7
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Core Application
NODE_ENV=development
APP_URL=http://localhost:3000
PRODUCT_NAME=Freelance Platform

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/freelance_platform
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/freelance_platform

# Authentication & Sessions
AUTH_SECRET=replace_with_64_char_hex_random_secret_in_production
AUTH_URL=http://localhost:3000

# Private Identity Encryption & Blind Indexing
# 32-byte hex key for AES-256-GCM encryption of private identity fields
PII_ENCRYPTION_KEY_CURRENT=replace_with_64_hex_chars_32_bytes
PII_ENCRYPTION_KEY_PREVIOUS=
# 32-byte hex key for HMAC-SHA256 blind indexing of phone numbers
PII_HMAC_KEY=replace_with_64_hex_chars_32_bytes

# Transactional Email Provider (mock | resend | smtp)
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@freelance-platform.local
EMAIL_API_KEY=

# SMS OTP Provider (mock | twilio | netgsm)
SMS_PROVIDER=mock
SMS_API_KEY=

# Observability
OBSERVABILITY_PII_REDACTION=true

# Feature Flags (All must default false unless authorized)
FEATURE_IDENTITY_VERIFICATION=false
FEATURE_MARKETING_EMAIL=false
FEATURE_PUBLIC_OFFER_COUNT=false

# Legal & Compliance Configuration (§18.7)
# In production, these must be non-empty and validated.
LEGAL_ENTITY_NAME=Platform Teknoloji Anonim Sirketi
LEGAL_ENTITY_TYPE=Anonim Sirket
LEGAL_ADDRESS=Buyukdere Cad. No: 100 Sisli, Istanbul, Turkiye
LEGAL_SUPPORT_EMAIL=destek@freelance-platform.local
LEGAL_PRIVACY_EMAIL=kvkk@freelance-platform.local
LEGAL_PHONE=+90 212 555 0100
MERSIS_NO=0123456789000001
TAX_NO=1234567890
KEP_ADDRESS=platform@hs01.kep.tr
TERMS_EFFECTIVE_DATE=2026-09-06
PRIVACY_EFFECTIVE_DATE=2026-09-06
LEGAL_ETBIS_CLASSIFICATION_APPROVED=true
LEGAL_PRIVACY_REVIEW_APPROVED=true
